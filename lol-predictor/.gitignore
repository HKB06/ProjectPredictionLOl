# Environnements
venv/
.venv/
__pycache__/
*.pyc

# Secrets (cle API odds-api.io) — ne JAMAIS committer
oddsapi.key
*.key
.env
.env.*

# Données brutes volumineuses (ne pas versionner les gros CSV)
data/raw/*.csv
data/interim/*
data/processed/*
!data/**/.gitkeep

# Modèles entraînés
models/*.txt
models/*.pkl
!models/.gitkeep

# Rapports générés (sorties reproductibles : tout le dossier sauf le .gitkeep)
reports/*
!reports/.gitkeep
