# Environnements
venv/
.venv/
__pycache__/
*.pyc

# Secrets (cle API odds-api.io) — ne JAMAIS committer
oddsapi.key
*.key
.env
.env.*

# Données brutes volumineuses (ne pas versionner les gros CSV)
data/raw/*.csv
data/interim/*
data/processed/*
!data/**/.gitkeep

# Modèles entraînés
models/*.txt
models/*.pkl
!models/.gitkeep

# Rapports générés (sorties reproductibles : tout le dossier sauf le .gitkeep)
reports/*
!reports/.gitkeep

# Compteur de quota + progression de découverte : purement locaux
data/.odds_quota.json
data/.odds_discovery.json

# ... mais l'archive des cotes de clôture, elle, DOIT être versionnée : l'app
# déployée ne peut pas la reconstruire (100 req/h, et pas de clé côté Cloud).
!data/odds_history.csv
